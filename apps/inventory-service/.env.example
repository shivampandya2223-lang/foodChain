INVENTORY_SERVICE_PORT=1306
NODE_ENV=production

DB_HOST=your-postgres-host
DB_PORT=5432
DB_USERNAME=your-postgres-user
DB_PASSWORD=your-postgres-password
DB_NAME=food_chain
JWT_SECRET=replace-with-strong-secret

KAFKA_ENABLED=true
KAFKA_CLIENT_ID=food-chain-inventory
KAFKA_BROKERS=kafka-1.example.com:9092,kafka-2.example.com:9092
KAFKA_INVENTORY_GROUP_ID=food-chain-inventory
KAFKA_NOTIFICATION_GROUP_ID=food-chain-notification
KAFKA_ANALYTICS_GROUP_ID=food-chain-analytics
KAFKA_ADMIN_DASHBOARD_GROUP_ID=food-chain-admin-dashboard
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=your-kafka-username
KAFKA_SASL_PASSWORD=your-kafka-password

REDIS_ENABLED=true
REDIS_URL=redis://your-redis-host:6379
MONGO_ENABLED=false
MONGO_URI=mongodb://your-mongo-host:27017
